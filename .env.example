# Copy to .env.local. Secrets remain server-side; never prefix them NEXT_PUBLIC_.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=1800
LLM_TIMEOUT_MS=90000

# json_object works with DeepSeek and many compatible providers.
# Use json_schema only if your provider supports strict JSON Schema output.
# Both modes are always validated on the server; failures fall back to rules.
LLM_STRUCTURED_OUTPUT=json_object

# Ethereum MAINNET only. Defaults to a public read-only RPC.
# Use a dedicated provider for reliable production limits; keep its key private.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

# Optional embeddings. The default is deterministic lexical retrieval.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Enable Web Analytics in Vercel project settings, then set this before building.
# No chat text, wallet addresses or custom chat events are sent to Analytics.
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Infent website accounts (project: Infent Accounts).
# The publishable key is public; all other keys below stay server-side.
NEXT_PUBLIC_SUPABASE_URL=https://xkqvmqyseunbeaipheyq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SOFTR_API_KEY=
SOFTR_DATABASE_ID=49fb0a81-0450-47e7-8a08-ecbfa8e2c082
SOFTR_USERS_TABLE_ID=O9N2m0m0P3H8pI
# Private bearer secret used by Vercel Cron to retry pending profile sync.
CRON_SECRET=
